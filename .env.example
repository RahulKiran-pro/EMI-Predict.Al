# EMIPredict AI — Environment Configuration Template
# Copy this file to .env and customize as needed.
# DO NOT commit .env containing real credentials or secrets to version control.

# Streamlit Port Configuration (Default: 8501)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# MLflow Tracking Configuration (Default: local SQLite database)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
